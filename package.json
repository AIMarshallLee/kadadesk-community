{
  "name": "@kadadesk/community",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first source-available multi-account personal social media content operations assistant",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "start": "tsx server/index.ts",
