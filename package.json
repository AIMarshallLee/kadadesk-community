{
  "name": "kadadesk-community",
  "version": "0.3.0",
  "private": true,
  "description": "咔哒 KADAdesk 社区版 · 企业私域的开放 AI 工作台",
  "type": "module",
  "main": "desktop-build/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx server/index.ts",
    "build": "node scripts/manual.mjs && tsc --noEmit && vite build",
    "manual": "node scripts/manual.mjs",
    "manual:check": "node scripts/manual.mjs --check",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "npm run build && npm run build:desktop && electron .",
    "package:win": "npm run build && npm run build:desktop && node scripts/package-desktop.mjs",
    "test": "tsx --test server/*.test.ts desktop/*.test.ts shared/*.test.ts",
    "mcp": "tsx desktop/kadadesk-mcp-cli.ts --stdio",
    "start": "tsx server/index.ts",
    "build:mac-native": "node scripts/build-macos.mjs",
    "verify": "node scripts/verify-publication.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@google/genai": "2.22.0",
    "@ui-tars/sdk": "1.2.3",
    "csv-parse": "7.0.2",
    "exceljs": "4.4.0",
    "lucide-react": "1.45.0",
    "mammoth": "1.12.3",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.1.200",
    "pinyin-pro": "3.29.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "twitter-text": "3.1.0",
    "unpdf": "1.8.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@electron/osx-sign": "2.7.0",
    "@electron/packager": "20.3.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "0.12.3"
    }
  },
  "productName": "咔哒"
}
